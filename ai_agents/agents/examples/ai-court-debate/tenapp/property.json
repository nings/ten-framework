                }
              }
            }
          ],
          "connections": [
            {
              "extension": "main_control",
              "cmd": [
                {
                  "names": ["on_user_joined", "on_user_left"],
                  "source": [{"extension": "agora_rtc"}]
                },
                {
                  "names": ["tool_register"],
                  "source": [
                    {"extension": "legal_knowledge"},
                    {"extension": "case_analyzer"}
                  ]
                }
              ],
              "data": [
                {
                  "name": "asr_result",

# AI Court Debate Agent - 环境变量配置示例
# 复制此文件为 .env 并填入实际的 API Keys

# ============================================
# Agora 实时音视频配置
# 访问 https://www.agora.io/ 获取
# ============================================
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_certificate_here

# ============================================
# Deepgram 语音识别配置
# 访问 https://deepgram.com/ 获取
# 支持中文（zh-CN）识别
# ============================================
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ============================================
# 国产大模型配置（选择其一填入）
# ============================================

# 1. DeepSeek（推荐，默认图：ai_court_debate_deepseek）
# 访问 https://platform.deepseek.com/ 获取
# 模型：deepseek-chat / deepseek-reasoner（R1推理模型）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 2. 通义千问 Qwen（阿里云）（图：ai_court_debate_qwen）
# 访问 https://dashscope.aliyun.com/ 获取
# 模型：qwen-max / qwen-plus / qwen-turbo / qwen-long
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 3. Kimi 月之暗面（图：ai_court_debate_kimi）
# 访问 https://platform.moonshot.cn/ 获取
# 模型：moonshot-v1-8k / moonshot-v1-32k / moonshot-v1-128k
MOONSHOT_API_KEY=your_moonshot_api_key_here

# 4. 智谱AI GLM（图：ai_court_debate_glm）
# 访问 https://open.bigmodel.cn/ 获取
# 模型：glm-4 / glm-4-flash / glm-4-air
ZHIPU_API_KEY=your_zhipu_api_key_here

# 5. 字节跳动 豆包 Doubao（图：ai_court_debate_doubao）
# 访问 https://www.volcengine.com/product/ark 获取
# 模型：需要使用 endpoint ID，如 ep-20240101xxxxx-xxxxx
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_MODEL=doubao-pro-32k

# ============================================
# ElevenLabs 语音合成配置
# 访问 https://elevenlabs.io/ 获取
# ============================================
ELEVENLABS_TTS_KEY=your_elevenlabs_api_key_here

# ============================================
# 其他配置
# ============================================
LOG_LEVEL=info
